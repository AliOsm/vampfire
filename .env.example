BASE_URL=http://localhost:8080
BIND=127.0.0.1
PORT=8080
# Only list addresses of reverse proxies that you control.
# For the Docker Caddy proxy, use TRUSTED_PROXIES=127.0.0.1 and BASE_URL=http://localhost:8088.
TRUSTED_PROXIES=
# mise loads generated VAPID keys from .data/push.env after `mise run push:keys`.
